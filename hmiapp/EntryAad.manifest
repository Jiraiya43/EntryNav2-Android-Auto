<?xml version="1.0" encoding="utf-8"?>
<plugin>
	<name>EntryAad</name>
	<type>App</type>
	<file>{pluginDir}/EntryAad</file>
	<config>
		<autoStart>yes</autoStart>
		<dependencies>
			<pluginAppConnector>
				<type>Etch</type>
				<id>210</id>
				<asyncCallbacks>yes</asyncCallbacks>
			</pluginAppConnector>
		</dependencies>
		<parameters>
			<DescFile>{pluginDir}/EntryAad.xml</DescFile>
			<TextDBFile>{pluginDir}/EntryAad_ALL_Texts.zip</TextDBFile>
			<ImageDBFile>{pluginDir}/EntryAad_ALL_Images.zip</ImageDBFile>
		</parameters>
	</config>
</plugin>
